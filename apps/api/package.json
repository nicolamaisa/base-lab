{
  "name": "@nicolamaisa/base-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "format:write": "prettier --ignore-path ../../.prettierignore --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/swagger-ui": "^0.6.0",
    "@hono/zod-openapi": "^1.2.2",
    "bullmq": "^5.78.1",
    "hono": "^4.6.12",
    "html-entities": "^2.6.0",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.12",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.10.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.9.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}

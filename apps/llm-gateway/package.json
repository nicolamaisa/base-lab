{
  "name": "@nicolamaisa/base-lab-llm-gateway",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "format:write": "prettier --ignore-path ../../.prettierignore --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "hono": "^4.12.21",
    "openai": "^6.42.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "eslint": "^9.9.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}

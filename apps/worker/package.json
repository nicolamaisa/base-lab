{
  "name": "@nicolamaisa/base-lab-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "format:write": "prettier --ignore-path ../../.prettierignore --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "bullmq": "^5.78.1",
    "hono": "^4.12.21",
    "ioredis": "^5.11.1",
    "kysely": "^0.28.12",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "js-yaml": "^4.1.2"
  },
  "devDependencies": {
    "@redocly/openapi-core": "^1.34.8",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.10.2",
    "eslint": "^9.9.0",
    "openapi-typescript": "^7.13.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "msgpackr-extract@3.0.4": true
  }
}

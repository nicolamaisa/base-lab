# General
PROJECT_NAME=Base Lab
PROJECT_SLUG=base-lab


SITE_URL=http://localhost:8000
AUTH_EXTERNAL_URL=http://localhost:8000/auth/v1
GOTRUE_URI_ALLOW_LIST=http://localhost:8000/**
PUBLIC_URL=http://localhost:8000

KONG_PLUGINS_CORS_CONFIG_ORIGINS='["http://localhost:5173","https://localhost:5173","http://localhost:8000"]'
KONG_PROXY_PORT=8000

# Postgres
POSTGRES_USER=base
POSTGRES_PASSWORD=
POSTGRES_DB=base
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
POSTGRES_DEV_PORT=5432

# Asymmetric Auth and opaque API keys
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_SECRET=
JWT_KEYS=[]
JWT_JWKS={"keys":[]}

# LLM gateway
LLM_GATEWAY_URL=http://llm-gateway:3003
LLM_REQUEST_TIMEOUT_MS=300000

# Ollama runtime profile: cpu, rocm, or nvidia
COMPOSE_PROFILES=cpu

# Used only by the AMD ROCm profile when required by the host GPU
HSA_OVERRIDE_GFX_VERSION=11.0.0

OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_DEFAULT_MODEL=qwen3:4b

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_TITLE=Base Lab

# Queue
BASE_QUEUE_NAME=base-queue
LLM_MODEL_PULL_QUEUE_NAME=llm-model-pulls

# Worker
BASE_RUN_WORKER_CONCURRENCY=2
LLM_MODEL_PULL_WORKER_CONCURRENCY=1
BASE_RUNS_RECONCILER_ENABLED=true
BASE_RUNS_RECONCILE_INTERVAL_MS=30000
BASE_RUNS_RECONCILE_BATCH_SIZE=100